<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>NASA Live - Sem YouTube</title>
  <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
  <style>
    body { background: #000; color: #fff; text-align: center; font-family: Arial; }
    video { width: 80%; margin-top: 20px; border-radius: 10px; }
  </style>
</head>
<body>
  <h1>Transmissão ao Vivo da NASA</h1>
  <video id="video" controls autoplay></video>

  <script>
    const video = document.getElementById('video');
    const videoSrc = 'https://nasatv-lh.akamaihd.net/i/NASA_101@319270/master.m3u8';

    if (Hls.isSupported()) {
      const hls = new Hls();
      hls.loadSource(videoSrc);
      hls.attachMedia(video);
      hls.on(Hls.Events.MANIFEST_PARSED, () => video.play());
    } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
      video.src = videoSrc;
      video.addEventListener('loadedmetadata', () => video.play());
    } else {
      alert('Seu navegador não suporta vídeo ao vivo HLS.');
    }
  </script>
</body>
</html> 
